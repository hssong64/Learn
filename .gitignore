# ---------- 安全学习相关 ----------
# 靶场/工具误提交的 shell 与凭据（谨慎）
*.msfvenom
*.msfvenom.*
shell.*
webshell.*
*.war.xml
# 本地笔记中可能含内网地址时建议：
# **/internal-notes/**
# **/lab-notes/**  # 若 lab-notes 不进库

# ---------- Markdown / 文档工具 ----------
# 如用 mkdocs/docusaurus 等，常见产出目录：
site/
docs/_build/
.jekyll-cache/
.jekyll-metadata
_book/
_cache/
*.epub
*.mobi
# 注意：本仓库 cybersecurity/doc/** 学习笔记是源文件，不要忽略

# ---------- 数据科学 / Jupyter ----------
.ipynb_checkpoints/
*.nbconvert.ipynb
